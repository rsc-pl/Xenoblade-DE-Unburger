      "$id": 86,
      "style": 124,
      "name": ""
    },
    {
      "$id": 87,
      "style": 124,
      "name": "to you."
    },
    {
      "$id": 88,
      "style": 124,
      "name": ""
    },
    {
      "$id": 89,
      "style": 124,
      "name": "Many times, your visions have allowed you\nto change the passage of fate."
