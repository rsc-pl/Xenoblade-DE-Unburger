    },
    {
      "$id": 2,
      "style": 124,
      "name": "Are you awake, Onii-chan?"
    },
    {
      "$id": 3,
      "style": 124,
      "name": ""
    },
    {
      "$id": 4,
      "style": 124,
      "name": "Yeah.[XENO:line ] Is that food?"
    },
    {
      "$id": 5,
      "style": 124,
      "name": ""
    },
    {
      "$id": 6,
      "style": 124,
      "name": "You didn't have to bring it all the way up here."
    },
    {
      "$id": 7,
      "style": 124,
      "name": "If you'd called me, I would've come down."
    },
    {
      "$id": 8,
      "style": 124,
      "name": ""
    },
    {
      "$id": 9,
      "style": 124,
      "name": "Don't be ridiculous."
    },
    {
      "$id": 10,
      "style": 124,
      "name": ""
    },
    {
      "$id": 11,
      "style": 124,
      "name": "Want me to feed you?"
    },
    {
      "$id": 12,
      "style": 124,
      "name": ""
    },
    {
      "$id": 13,
      "style": 124,
      "name": "Don't treat me like I'm sick."
    },
    {
      "$id": 14,
      "style": 124,
      "name": "I'm not in the same shape I was a year ago."
    },
    {
      "$id": 15,
      "style": 124,
      "name": ""
    },
    {
      "$id": 16,
      "style": 124,
      "name": "That's true."
    },
    {
      "$id": 17,
      "style": 124,
      "name": ""
    },
    {
      "$id": 18,
      "style": 124,
      "name": "Back then, I thought you were going to die.[XENO:line ]"
    },
    {
      "$id": 19,
      "style": 124,
      "name": ""
    },
    {
      "$id": 20,
      "style": 124,
      "name": "Yeah."
    },
    {
      "$id": 21,
      "style": 124,
      "name": "I could even wield the Monado again now."
    },
    {
      "$id": 22,
      "style": 124,
      "name": ""
    },
    {
      "$id": 23,
      "style": 124,
      "name": "Don't!"
    },
    {
      "$id": 24,
      "style": 124,
      "name": "The Machine God Soldiers don't even show up anymore,"
    },
    {
      "$id": 25,
      "style": 124,
      "name": "so why would you do that?!"
    },
    {
      "$id": 26,
      "style": 124,
      "name": ""
    },
    {
      "$id": 27,
      "style": 124,
      "name": "I just meant I'm ready if I have to."
    },
    {
      "$id": 28,
      "style": 124,
      "name": ""
    },
    {
      "$id": 29,
      "style": 124,
      "name": "Sorry."
    },
    {
      "$id": 30,
      "style": 124,
      "name": ""
    },
    {
      "$id": 31,
      "style": 124,
      "name": "It's okay.[XENO:line ]"
    },
    {
      "$id": 32,
      "style": 124,
      "name": ""
    },
    {
      "$id": 33,
      "style": 124,
      "name": "Anyway, eat it before it gets cold."
    },
    {
      "$id": 34,
      "style": 124,
      "name": ""
    },
    {
      "$id": 35,
      "style": 124,
      "name": "I'm really proud of this one."
    },
    {
      "$id": 36,
      "style": 124,
      "name": ""
    },
    {
      "$id": 37,
      "style": 124,
      "name": "In that case,"
    },
    {
      "$id": 38,
      "style": 124,
      "name": "you don't have to stay up here forever."
    },
    {
      "$id": 39,
      "style": 124,
      "name": ""
    },
    {
      "$id": 40,
      "style": 124,
      "name": "Hurry up and take it to him."
    },
    {
      "$id": 41,
      "style": 124,
      "name": ""
    },
    {
      "$id": 42,
      "style": 124,
      "name": "Huh?"
    },
    {
      "$id": 43,
      "style": 124,
      "name": ""
    },
    {
      "$id": 44,
      "style": 124,
      "name": "Don't you want Shulk"
    },
    {
      "$id": 45,
      "style": 124,
      "name": "to have it while it's still warm?"
    },
    {
      "$id": 46,
      "style": 124,
      "name": ""
    },
    {
      "$id": 47,
      "style": 124,
      "name": "It's fine!"
    },
    {
      "$id": 48,
      "style": 124,
      "name": ""
    },
    {
      "$id": 49,
      "style": 124,
      "name": "Shulk has no sense of taste anyway."
    },
    {
      "$id": 50,
      "style": 124,
      "name": ""
    },
    {
      "$id": 51,
      "style": 124,
      "name": "I'm sure he'll say it's delicious even if it's cold.[XENO:line ]"
    },
    {
      "$id": 52,
      "style": 124,
      "name": ""
    },
    {
      "$id": 53,
      "style": 124,
      "name": "Then"
    },
    {
      "$id": 54,
      "style": 124,
      "name": "you'll want him to really mean it today."
    },
    {
      "$id": 55,
      "style": 124,
      "name": ""
    },
    {
      "$id": 56,
      "style": 124,
      "name": "[XENO:line ]Yeah."
    },
    {
      "$id": 57,
      "style": 124,
      "name": ""
    },
    {
      "$id": 58,
      "style": 124,
      "name": "Don't worry about me."
    },
    {
      "$id": 59,
      "style": 124,
      "name": ""
    },
    {
      "$id": 60,
      "style": 124,
      "name": "Go on, hurry."
    },
    {
      "$id": 61,
      "style": 124,
      "name": ""
    },
    {
      "$id": 62,
      "style": 124,
      "name": "[XENO:line ]Yeah."
    },
    {
      "$id": 63,
      "style": 124,
      "name": ""
    },
    {
      "$id": 64,
      "style": 124,
      "name": "[XENO:line ]Thanks,"
    },
    {
      "$id": 65,
      "style": 124,
      "name": "Onii-chan."
    },
    {
      "$id": 66,
      "style": 124,
      "name": ""
    },
    {
      "$id": 67,
      "style": 124,
      "name": "That wasn't the end of it.[XENO:line ]"
