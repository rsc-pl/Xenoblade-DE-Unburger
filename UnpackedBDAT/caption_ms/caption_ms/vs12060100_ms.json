    {
      "$id": 2,
      "style": 124,
      "name": "I really thought I was dead."
    },
    {
      "$id": 3,
      "style": 124,
      "name": ""
    },
    {
      "$id": 4,
      "style": 124,
      "name": "I mean,"
    },
    {
      "$id": 5,
      "style": 124,
      "name": ""
    },
    {
      "$id": 6,
      "style": 124,
      "name": "the Machine God Soldiers tore me apart\nwith their iron claws and fangs[XENO:line ]"
    },
    {
      "$id": 7,
      "style": 124,
      "name": ""
    },
    {
      "$id": 8,
      "style": 124,
      "name": "I couldn't remember anything\nafter a certain point."
    },
    {
      "$id": 9,
      "style": 124,
      "name": ""
    },
    {
      "$id": 10,
      "style": 124,
      "name": "I couldn't hear or see anything.\nEven the pain was gone[XENO:line ]"
    },
    {
      "$id": 11,
      "style": 124,
      "name": ""
    },
    {
      "$id": 12,
      "style": 124,
      "name": "When I next came to,"
    },
    {
      "$id": 13,
      "style": 124,
      "name": ""
    },
    {
      "$id": 14,
      "style": 124,
      "name": "they'd turned my body into this machine."
    },
    {
      "$id": 15,
      "style": 124,
      "name": ""
    },
    {
      "$id": 16,
      "style": 124,
      "name": "No... that wasn't all."
    },
    {
      "$id": 17,
      "style": 124,
      "name": ""
    },
    {
      "$id": 18,
      "style": 124,
      "name": "There was someone inside me I didn't know[XENO:line ]"
    },
    {
      "$id": 19,
      "style": 124,
      "name": ""
    }
